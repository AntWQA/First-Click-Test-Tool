{
  "name": "wayfinding-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Moderated first click test tool. Builds to ONE self-contained HTML file that embeds a duplicate of the Storefront navigation prototype.",
  "scripts": {
    "dev": "vite -c vite.shell.config.ts",
    "dev:proto": "vite -c vite.proto.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.domain.json",
    "test": "node --test \"tests/*.test.ts\"",
    "build:single": "node scripts/build-single.mjs",
    "build:participant": "node scripts/build-single.mjs participant",
    "check:original": "sh scripts/check-original.sh",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "dependencies": {
    "@doterra-it/design-system-ui-base": "^2.6.0",
    "@doterra-it/design-system-ui-carousel": "^2.6.0",
    "@doterra-it/design-system-ui-ecommerce": "^2.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
